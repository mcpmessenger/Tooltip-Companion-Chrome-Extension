{
    "family": "tooltip-companion-backend",
    "networkMode": "awsvpc",
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "1024",
    "memory": "4096",
    "taskRoleArn": "arn:aws:iam::396608803476:role/ecsTaskRole",
    "executionRoleArn": "arn:aws:iam::396608803476:role/ecsTaskExecutionRole",
    "containerDefinitions": [
        {
            "name": "tooltip-companion-backend",
            "image": "396608803476.dkr.ecr.us-east-1.amazonaws.com/tooltip-companion-backend:latest",
            "portMappings": [
                {
                    "containerPort": 3000,
                    "hostPort": 3000,
                    "protocol": "tcp"
                }
            ],
            "essential": true,
            "environment": [
                {
                    "name": "PORT",
                    "value": "3000"
                },
                {
                    "name": "NODE_ENV",
                    "value": "production"
                },
                {
                    "name": "OPENAI_API_KEY",
                    "value": "YOUR_OPENAI_API_KEY_HERE"
                }
            ],
            "mountPoints": [],
            "volumesFrom": [],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/tooltip-companion-backend",
                    "awslogs-region": "us-east-1",
                    "awslogs-stream-prefix": "ecs"
                }
            },
            "healthCheck": {
                "command": [
                    "CMD-SHELL",
                    "node -e \"require('http').get('http://localhost:3000/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})\""
                ],
                "interval": 30,
                "timeout": 5,
                "retries": 3,
                "startPeriod": 40
            },
            "systemControls": []
        }
    ]
}

